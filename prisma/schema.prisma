// NGA Inventra - Enterprise Inventory & Asset Management System
// Prisma Schema Definition for MySQL 8+

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
  INVENTORY_STAFF
  ASSET_CUSTODIAN
  AUDITOR
}

enum ItemType {
  CONSUMABLE
  SERIALIZED_ASSET
}

enum MovementType {
  IN
  OUT
  TRANSFER
  RETURN
  ADJUSTMENT
}

enum MovementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  DISPOSED
  LOST
}

enum AssetCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
}

enum RequestUrgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum OpnameStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          RoleType  @default(INVENTORY_STAFF)
  department    String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdMovements    StockMovement[]   @relation("MovementCreator")
  approvedMovements   StockMovement[]   @relation("MovementApprover")
  assignedAssets      AssetUnit[]       @relation("AssetCustodian")
  assetAssignments    AssetAssignment[] @relation("AssignedToUser")
  assignedByLogs      AssetAssignment[] @relation("AssignedByUser")
  itemRequests        ItemRequest[]     @relation("RequestRequester")
  approvedRequests    ItemRequest[]     @relation("RequestApprover")
  auditLogs           AuditLog[]
  managedWarehouses   Warehouse[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  items       Item[]

  @@map("categories")
}

model Unit {
  id          String   @id @default(uuid())
  name        String   @unique
  symbol      String   @unique
  description String?
  items       Item[]

  @@map("units")
}

model Supplier {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  city         String?
  rating       Float           @default(5.0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  items        Item[]
  movements    StockMovement[]

  @@map("suppliers")
}

model Warehouse {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  branch      String
  address     String
  capacityCbm Float           @default(1000.0)
  managerId   String?
  manager     User?           @relation(fields: [managerId], references: [id])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  stockBalances       StockBalance[]
  locations           WarehouseLocation[]
  sourceMovements     StockMovement[]     @relation("SourceWarehouse")
  targetMovements     StockMovement[]     @relation("TargetWarehouse")
  assetUnits          AssetUnit[]
  stockOpnames        StockOpname[]

  @@map("warehouses")
}

model WarehouseLocation {
  id          String      @id @default(uuid())
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String      // e.g. RACK-A-01-B
  aisle       String
  rack        String
  shelf       String
  bin         String?
  assetUnits  AssetUnit[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model Item {
  id             String      @id @default(uuid())
  sku            String      @unique
  barcode        String?     @unique
  name           String
  description    String?
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  unitId         String
  unit           Unit        @relation(fields: [unitId], references: [id])
  supplierId     String?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id])
  
  // Separation of consumable quantity stock vs unique serialized assets
  itemType       ItemType    @default(CONSUMABLE)

  // Quantity and Thresholds
  currentStock   Int         @default(0)
  minStock       Int         @default(10)
  maxStock       Int         @default(500)
  reorderPoint   Int         @default(20)
  safetyStock    Int         @default(5)

  // Valuation
  unitCost       Decimal     @db.Decimal(12, 2)
  unitPrice      Decimal     @db.Decimal(12, 2)

  specifications Json?
  imageUrl       String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  stockBalances  StockBalance[]
  movementItems  StockMovementDetail[]
  assetUnits     AssetUnit[]
  requestItems   ItemRequestDetail[]
  opnameDetails  StockOpnameDetail[]

  @@index([categoryId])
  @@index([itemType])
  @@map("items")
}

model StockBalance {
  id          String    @id @default(uuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, warehouseId])
  @@map("stock_balances")
}

model StockMovement {
  id                String               @id @default(uuid())
  movementNumber    String               @unique // e.g. MOV-202610-001
  type              MovementType
  status            MovementStatus       @default(COMPLETED)
  sourceWarehouseId String?
  sourceWarehouse   Warehouse?           @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouseId String?
  targetWarehouse   Warehouse?           @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  supplierId        String?
  supplier          Supplier?            @relation(fields: [supplierId], references: [id])
  
  referenceDoc      String?              // PO-1234, DO-5678, REQ-099
  idempotencyKey    String?              @unique
  notes             String?
  
  createdByUserId   String
  createdByUser     User                 @relation("MovementCreator", fields: [createdByUserId], references: [id])
  approvedByUserId  String?
  approvedByUser    User?                @relation("MovementApprover", fields: [approvedByUserId], references: [id])
  
  createdAt         DateTime             @default(now())
  details           StockMovementDetail[]

  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockMovementDetail {
  id          String        @id @default(uuid())
  movementId  String
  movement    StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  quantity    Int
  unitCost    Decimal       @db.Decimal(12, 2)
  subtotal    Decimal       @db.Decimal(14, 2)
  notes       String?

  @@map("stock_movement_details")
}

model AssetUnit {
  id              String             @id @default(uuid())
  assetTag        String             @unique // AST-2026-0001
  serialNumber    String             @unique // SN-DELL-9821
  itemId          String
  item            Item               @relation(fields: [itemId], references: [id])
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  locationId      String?
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  
  status          AssetStatus        @default(AVAILABLE)
  condition       AssetCondition     @default(GOOD)
  
  assignedToUserId String?
  assignedToUser  User?              @relation("AssetCustodian", fields: [assignedToUserId], references: [id])
  department      String?
  
  purchaseDate    DateTime?
  purchaseCost    Decimal            @db.Decimal(12, 2)
  warrantyExpiry  DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  assignments     AssetAssignment[]

  @@index([status])
  @@index([assignedToUserId])
  @@map("asset_units")
}

model AssetAssignment {
  id                    String         @id @default(uuid())
  assetUnitId           String
  assetUnit             AssetUnit      @relation(fields: [assetUnitId], references: [id], onDelete: Cascade)
  assignedToUserId      String
  assignedToUser        User           @relation("AssignedToUser", fields: [assignedToUserId], references: [id])
  assignedByUserId      String
  assignedByUser        User           @relation("AssignedByUser", fields: [assignedByUserId], references: [id])
  department            String
  assignedAt            DateTime       @default(now())
  returnedAt            DateTime?
  conditionAtAssignment AssetCondition
  conditionAtReturn     AssetCondition?
  notes                 String?

  @@map("asset_assignments")
}

model StockOpname {
  id            String              @id @default(uuid())
  opnameNumber  String              @unique // OPN-202610-01
  warehouseId   String
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  scheduledDate DateTime
  status        OpnameStatus        @default(DRAFT)
  notes         String?
  createdAt     DateTime            @default(now())
  details       StockOpnameDetail[]

  @@map("stock_opnames")
}

model StockOpnameDetail {
  id               String      @id @default(uuid())
  opnameId         String
  opname           StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item        @relation(fields: [itemId], references: [id])
  systemStock      Int
  physicalStock    Int
  difference       Int         // physicalStock - systemStock
  unitCost         Decimal     @db.Decimal(12, 2)
  discrepancyValue Decimal     @db.Decimal(14, 2)
  notes            String?

  @@map("stock_opname_details")
}

model ItemRequest {
  id               String              @id @default(uuid())
  requestNumber    String              @unique // REQ-202610-001
  department       String
  urgency          RequestUrgency      @default(NORMAL)
  status           RequestStatus       @default(PENDING)
  reason           String
  
  requestedByUserId String
  requestedByUser  User                @relation("RequestRequester", fields: [requestedByUserId], references: [id])
  approvedByUserId String?
  approvedByUser   User?               @relation("RequestApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime            @default(now())
  details          ItemRequestDetail[]

  @@map("item_requests")
}

model ItemRequestDetail {
  id           String      @id @default(uuid())
  requestId    String
  request      ItemRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item        @relation(fields: [itemId], references: [id])
  requestedQty Int
  approvedQty  Int?

  @@map("item_request_details")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE_ITEM, GOODS_RECEIPT, STOCK_OUT, ASSET_TRANSFER, etc.
  entity      String   // Item, StockMovement, AssetUnit, etc.
  entityId    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  userName    String?
  ipAddress   String?
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
